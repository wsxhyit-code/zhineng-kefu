# ---------- Python ----------
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/

# ---------- 密钥 ----------
# .env 的各种变体(备份、按环境分的副本)同样含真实密钥,必须一起挡住。
# 只放行 .env.example —— 它是对外发布的模板,里面只有占位符。
.env
.env.*
!.env.example

# ---------- 本机工具链 ----------
# 本机把 uv 的包缓存和托管的 Python 3.12 放在工作区内(见 scripts/dev.ps1 里的说明),不入库
.uv-cache/
.uv-python/
# HuggingFace 模型缓存(分类器基础模型 800MB+),首次跑 make classifier-train 时自动下载
.hf-cache/
.superpowers/
dev-notes/

# ---------- 测试产物 ----------
.pytest_cache/
.pytest-basetemp/
.pytest-tmp/
pytest-cache-files-*/

# ---------- 运行时产物 ----------
log/
logs/
*.pid
data/*.log
data/rag/*.log
data/*.db*
data/*.sqlite*

# ---------- 分类器模型产物 ----------
# 基础模型、微调权重、ONNX 导出、教师缓存加起来约 2GB,不进 Git。
# 复现方式见 REPRO.md;只有评测报告入库,当证据看。
data/classifier/*
!data/classifier/reports

# ---------- 实验脚本的检索缓存 ----------
# (300 题 rerank 结果,可重跑生成),不入库
.exp_cache/

# ---------- 本机配置备份 ----------
.docker-daemon.backup.json

# ---------- 操作系统 / 编辑器 ----------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp